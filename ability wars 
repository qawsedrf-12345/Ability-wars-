}

local ProtectedPlayers = {}

-- ==========================================
-- SISTEMA DE SALVAMENTO
-- ==========================================
local function SaveConfig()
    if writefile then
        pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(Config)) end)
    end
end

local function LoadConfig()
    if isfile and isfile(CONFIG_FILE) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if success and data then
            for k, v in pairs(data) do
                if type(v) == "table" and Config[k] then
                    for k2, v2 in pairs(v) do Config[k][k2] = v2 end
                else
                    Config[k] = v
                end
            end
        end
    end
end
LoadConfig()

-- ==========================================
-- LÓGICA DE COMBATE
-- ==========================================
local State = { lastBypass = 0, auraThread = nil }

local function gc() return LP.Character end
local function gr() local c = gc() return c and c:FindFirstChild("HumanoidRootPart") end
local function al(m) if not m or not m.Parent then return false end local h = m:FindFirstChildOfClass("Humanoid") return h and h.Health > 0 end
local function fhp(target) if not target then return nil end for _, name in ipairs({"Head","UpperTorso","Torso","HumanoidRootPart","LeftHand","RightHand"}) do local p = target:FindFirstChild(name) if p and p:IsA("BasePart") then return p end end return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart") end

local function collectTargets(range)
    local hrp = gr() if not hrp then return {} end
    local myPos = hrp.Position local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and al(plr.Character) and not ProtectedPlayers[plr.UserId] then
            local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if tHRP and (tHRP.Position - myPos).Magnitude <= range then
                table.insert(list, plr.Character)
            end
        end
    end
    return list
end

local function closestTarget(range)
    local hrp = gr() if not hrp then return nil end
    local myPos = hrp.Position local best, bestDist = nil, range
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and al(plr.Character) and not ProtectedPlayers[plr.UserId] then
            local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then
                local d = (tHRP.Position - myPos).Magnitude
                if d <= bestDist then bestDist = d best = plr.Character end
            end
        end
    end
    return best
end

local function sp(target, abilityId)
    local char = gc() local hrp = gr() if not char or not hrp then return end
    local hitbox = char:FindFirstChild("Hitbox") local weld = hrp:FindFirstChild("Hitbox Weld")
    if not hitbox or not weld then return end
    local hitPart = fhp(target) if not hitPart then return end
    local camera = workspace.CurrentCamera local mousePos = camera.CFrame.Position + camera.CFrame.LookVector * 100
    SendPacket:FireServer("Use Ability", "Punch", char:GetPivot(), mousePos, nil)
    task.wait(0.05)
    pcall(function()
        SendPacket:FireServer("Use Punch", abilityId, target, hitbox.Position + Vector3.new(0, 0.5, 0), 2, hitbox.Size, weld.C0, hitPart, hitPart.Size, hrp.CFrame.LookVector)
    end)
end

local function pb()
    local now = os.clock() if now - State.lastBypass < 0.3 then return end
    local target = closestTarget(Config.PunchBypass.range) if not target then return end
    State.lastBypass = now pcall(sp, target, Config.PunchBypass.abilityId)
end

local function sa()
    if State.auraThread then return end State.auraThread = true
    task.spawn(function()
        while true do
            if Config.MiniAura.enabled then
                local targets = collectTargets(Config.MiniAura.range)
                if #targets > 0 then
                    local target = targets[math.random(#targets)]
                    if target and target.Parent then pcall(sp, target, Config.MiniAura.abilityId) end
                end
                task.wait(Config.MiniAura.interval)
            else
                task.wait(0.2)
            end
        end
    end)
end

