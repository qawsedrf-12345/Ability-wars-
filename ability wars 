TabProtection:Section({ Title = "Jogadores no Servidor" })

local function updatePlayerList()
    for _, child in ipairs(TabProtection.Container:GetChildren()) do
        if child:IsA("Frame") and child.Name == "CustomPlayerRow" then
            child:Destroy()
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local row = Instance.new("Frame")
            row.Name = "CustomPlayerRow"
            row.Size = UDim2.new(1, -20, 0, 35)
            row.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            row.BorderSizePixel = 0
            row.Parent = TabProtection.Container
            
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = row

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(0.6, 0, 1, 0)
            nameLbl.Position = UDim2.new(0, 10, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = plr.Name
            nameLbl.TextColor3 = ProtectedPlayers[plr.UserId] and Color3.fromRGB(50, 220, 50) or Color3.fromRGB(240, 240, 240)
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Font = Enum.Font.GothamMedium
            nameLbl.TextSize = 14
            nameLbl.Parent = row

            local btnGreen = Instance.new("TextButton")
            btnGreen.Size = UDim2.new(0, 24, 0, 24)
            btnGreen.Position = UDim2.new(1, -60, 0.5, -12)
            btnGreen.BackgroundColor3 = Color3.fromRGB(40, 200, 40)
            btnGreen.Text = "✔"
            btnGreen.TextColor3 = Color3.new(1,1,1)
            btnGreen.Font = Enum.Font.GothamBold
            btnGreen.Parent = row
            Instance.new("UICorner", btnGreen).CornerRadius = UDim.new(0, 4)

            local btnRed = Instance.new("TextButton")
            btnRed.Size = UDim2.new(0, 24, 0, 24)
            btnRed.Position = UDim2.new(1, -30, 0.5, -12)
            btnRed.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            btnRed.Text = "✖"
            btnRed.TextColor3 = Color3.new(1,1,1)
            btnRed.Font = Enum.Font.GothamBold
            btnRed.Parent = row
            Instance.new("UICorner", btnRed).CornerRadius = UDim.new(0, 4)

            btnGreen.MouseButton1Click:Connect(function()
                ProtectedPlayers[plr.UserId] = true
                nameLbl.TextColor3 = Color3.fromRGB(50, 220, 50)
            end)

            btnRed.MouseButton1Click:Connect(function()
                ProtectedPlayers[plr.UserId] = nil
                nameLbl.TextColor3 = Color3.fromRGB(200, 40, 40)
            end)
        end
    end
end

