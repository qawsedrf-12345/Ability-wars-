			t:Play() t.Completed:Wait() btnMin.Text = "–" 
		end 
		State.isAnimating = false
		-- Garante que o menu não saia da tela após mudar de tamanho
		clampToScreen()
	end)

	-- Arrasto
	local function startDrag(input) 
		if State.isLocked then return end 
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
			State.dragging = true 
			State.dragStart = input.Position 
			State.dragOrigin = frame.AbsolutePosition -- Salva a posição absoluta
		end 
	end 
	
	title.InputBegan:Connect(startDrag) 
	frame.InputBegan:Connect(startDrag)
	
	UIS.InputChanged:Connect(function(input) 
		if not State.dragging then return end 
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then 
			local delta = input.Position - State.dragStart 
			
			-- Calcula a nova posição
			local newAbsX = State.dragOrigin.X + delta.X
			local newAbsY = State.dragOrigin.Y + delta.Y
			
			-- Pega o tamanho da tela e do menu
			local vp = workspace.CurrentCamera.ViewportSize
			local fSize = frame.AbsoluteSize
			
			-- Trava para o menu não sair da tela (0 até o limite máximo)
			local clampedX = math.clamp(newAbsX, 0, vp.X - fSize.X)
			local clampedY = math.clamp(newAbsY, 0, vp.Y - fSize.Y)
			
			frame.Position = UDim2.fromOffset(clampedX, clampedY) 
		end 
	end) 
	
